{
  "manifest_version": 3,
  "name": "__MSG_naam__",
  "short_name": "LANcelot",
  "description": "__MSG_beschrijving__",
  "version": "1.0.0",
  "default_locale": "nl",
  "minimum_chrome_version": "120",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "__MSG_naam__",
    "default_popup": "venster.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "achtergrond.js" },
  "permissions": ["tabs", "storage", "alarms", "identity", "identity.email", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["<all_urls>"],
  "storage": { "managed_schema": "schema.json" }
}
